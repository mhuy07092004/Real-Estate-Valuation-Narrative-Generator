#maps api key is on group sheet,
VITE_GOOGLE_MAPS_API_KEY=

# The deployed backend's origin (Render URL in prod, http://localhost:4000
# locally) — prefixed onto every API call via services/api-client.ts, since
# frontend (Vercel) and backend (Render) are separate origins in prod.
VITE_API_BASE_URL=http://localhost:4000

# Google OAuth 2.0 Client ID — same value as the backend's
# GOOGLE_OAUTH_CLIENT_ID (not a secret, safe to share). Team credentials sheet.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Microsoft OAuth 2.0 Client ID (Entra app registration) — same value as the
# backend's MICROSOFT_OAUTH_CLIENT_ID. Team credentials sheet.
VITE_MICROSOFT_OAUTH_CLIENT_ID=
