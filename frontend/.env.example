# Copy to .env.development (gitignored) for local work. On Vercel, set the same names under
# Settings → Environment Variables and REDEPLOY — Vite bakes them in at build time, and
# everything prefixed VITE_ is public in the built site (never put a secret here).
# Full explanation: frontend/README.md → "Environment variables".

# Backend origin. Leave EMPTY locally — the Vite dev server proxies /api to localhost:4000.
# Required on Vercel, e.g. https://relaive-backend-qj4inxugxa-ts.a.run.app (no trailing slash, no /api).
VITE_API_BASE_URL=

# Browser Google Maps JavaScript API key, referrer-restricted to http://localhost:5173/* and
# the production site. Without it the landing-page map shows "Map unavailable". Key on team credentials sheet.
VITE_GOOGLE_MAPS_API_KEY=

# Cloudflare Turnstile site key. Optional; the captcha only appears when the backend asks for it.
VITE_TURNSTILE_SITE_KEY=

# Google OAuth 2.0 Client ID — same value as the backend's
# GOOGLE_OAUTH_CLIENT_ID (not a secret, safe to share). Team credentials sheet.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# Microsoft OAuth 2.0 Client ID (Entra app registration) — same value as the backend's MICROSOFT_OAUTH_CLIENT_ID. Key on team credentials sheet.
VITE_MICROSOFT_OAUTH_CLIENT_ID=
