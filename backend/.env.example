# PORT is supplied automatically by Render — no need to set it there.
PORT=4000
# Comma-separated if you need more than one (e.g. Vercel prod + preview URLs):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-preview.vercel.app
CORS_ORIGIN=http://localhost:5173
# No quotes — `docker run --env-file` passes values through literally
# (including quote characters), unlike dotenv, which strips them.
DATABASE_URL=file:./dev.db

# Change these before any real deployment — dev-only defaults are used otherwise.
# On Render, set real random values (e.g. `openssl rand -hex 32`) as env vars —
# do not reuse the dev defaults below.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN=7d

# Proxy hops in front of the app, so req.ip is the real client IP that the
# adaptive-captcha risk scoring keys off. Set to 1 on Render; leave 0 locally.
TRUST_PROXY=0

# Cloudflare Turnstile — server-side secret key used to verify captcha tokens.
# The captcha is only demanded on risky login/register attempts (repeated
# failures, attempt bursts, bulk signups) — see src/services/auth-risk.service.ts
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# ML price-prediction service — replaces the comparable-sales average used
# in appraisal-summary.controller.ts's midpoint estimate when configured.
# See src/services/price-prediction.service.ts. Leave blank until a model
# is actually deployed — the controller falls back to the comparable
# average automatically when this is unset or the call fails.
ML_PRICE_PREDICTION_URL=
ML_PRICE_PREDICTION_API_KEY=
