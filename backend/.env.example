# Copy to .env (gitignored) and fill in. .env is read only when the server starts —
# restart `npm run dev` after editing it. Full explanation of each variable:
# backend/README.md → "Environment variables".

# PORT is supplied by Render and Cloud Run — only set it for local dev.
PORT=4000

# Comma-separated if you need more than one (e.g. Vercel prod + preview URLs):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-preview.vercel.app
CORS_ORIGIN=http://localhost:5173

# Cloud SQL Postgres — there is NO local database. Your public IPv4 must be in the
# instance's authorized_ips (see infra/terraform/README.md). Get the value from
# `terraform output -raw database_url` or ask the team. No quotes —
# `docker run --env-file` passes quote characters through literally.
DATABASE_URL=postgresql://relaive_app:<password>@<cloud-sql-public-ip>:5432/relaive

# Dev-only defaults are used when unset. Anywhere real, use long random values
# (e.g. `openssl rand -hex 32`). The access secret also keys the sign-up code hashes.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN=7d

# Proxy hops in front of the app so req.ip is the real client IP (risk scoring).
# 1 on Render / Cloud Run, 0 locally.
TRUST_PROXY=0

# Cloudflare Turnstile server secret. Optional — adaptive captcha is currently off in code.
TURNSTILE_SECRET_KEY=

# SendGrid (HTTP API): sign-up codes and report emails. SENDGRID_FROM_EMAIL must be a
# verified sender. Locally you can leave these empty — outside production the sign-up
# code is also printed in the terminal as "[dev] OTP for <email>: <code>".
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Frontend origin, used to build /shared-report/:token links in emails.
PUBLIC_APP_URL=http://localhost:5173

# Google Maps SERVER key — Geocoding API + Places API (New), NO referrer restriction
# (Google rejects those for server-to-server calls). The browser key is a frontend variable.
# Restrict this key by IP address (or leave unrestricted for local dev) and scope its API
# restrictions to Geocoding API + Places API (New) only. Shared on the team credentials
# sheet — ask before generating a new one.
GOOGLE_MAPS_SERVER_KEY=

# AI price-prediction service (data_ai/service). Blank → falls back to the comparable-sales
# average. Called exactly as given; both "/" and "/predict" work.
ML_PRICE_PREDICTION_URL=
ML_PRICE_PREDICTION_API_KEY=

# Groq API — used to generate appraisal narrative text.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any current Groq chat model works; llama-3.3-70b-versatile is a good quality/speed/cost default.
# Alternatives: openai/gpt-oss-120b (higher quality, slower), llama-3.1-8b-instant (fastest/cheapest).
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=700

# Fine-tuned narrative model on Vertex AI. Needs `gcloud auth application-default login`
# locally. Blank, or no model deployed → templated report text (silent fallback).
# Project NUMBER (not the id), region, and the endpoint id (see data_ai/readme.md).
VERTEX_PROJECT_ID=393439107077
VERTEX_REGION=us-central1
VERTEX_ENDPOINT_ID=

# Google OAuth 2.0 Client ID — used to verify the ID token Google Identity
# Services hands back after "Sign in with Google". Unlike the Maps keys
# above, this is NOT a secret (it's embedded in the frontend bundle too, as
# VITE_GOOGLE_OAUTH_CLIENT_ID) — same value on both sides. Create it as a
# "Web application" OAuth client in Google Cloud Console, and add every
# origin you'll load the app from (http://localhost:5173, the real prod
# domain) under "Authorized JavaScript origins", or sign-in fails silently.
GOOGLE_OAUTH_CLIENT_ID=

# Microsoft OAuth 2.0 Client ID — used to verify the ID token MSAL hands back
# after "Sign in with Microsoft". Same "not a secret, same value on both
# sides" story as GOOGLE_OAUTH_CLIENT_ID above — this one is shared with
# VITE_MICROSOFT_OAUTH_CLIENT_ID. Create it as a "Single-page application"
# app registration in Microsoft Entra admin center (entra.microsoft.com),
# supporting "personal Microsoft accounts + any organizational directory",
# and add every origin you'll load the app from (http://localhost:5173, the
# real prod domain) under Authentication > Redirect URIs, or sign-in fails.
MICROSOFT_OAUTH_CLIENT_ID=
