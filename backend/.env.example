# PORT is supplied automatically by Render — no need to set it there.
PORT=4000
# Comma-separated if you need more than one (e.g. Vercel prod + preview URLs):
# CORS_ORIGIN=https://your-app.vercel.app,https://your-app-git-preview.vercel.app
CORS_ORIGIN=http://localhost:5173
# No quotes — `docker run --env-file` passes values through literally
# (including quote characters), unlike dotenv, which strips them.
DATABASE_URL=file:./dev.db

# Change these before any real deployment — dev-only defaults are used otherwise.
# On Render, set real random values (e.g. `openssl rand -hex 32`) as env vars —
# do not reuse the dev defaults below.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN_SECONDS=3600
JWT_REFRESH_EXPIRES_IN=7d

# Proxy hops in front of the app, so req.ip is the real client IP that the
# adaptive-captcha risk scoring keys off. Set to 1 on Render; leave 0 locally.
TRUST_PROXY=0

# Cloudflare Turnstile — server-side secret key used to verify captcha tokens.
# The captcha is only demanded on risky login/register attempts (repeated
# failures, attempt bursts, bulk signups) — see src/services/auth-risk.service.ts
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# ML price-prediction service — replaces the comparable-sales average used
# in appraisal-summary.controller.ts's midpoint estimate when configured.
# See src/services/price-prediction.service.ts. Leave blank until a model
# is actually deployed — the controller falls back to the comparable
# average automatically when this is unset or the call fails.
ML_PRICE_PREDICTION_URL=
ML_PRICE_PREDICTION_API_KEY=

# Groq API — used to generate appraisal narrative text.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
# Any current Groq chat model works; llama-3.3-70b-versatile is a good quality/speed/cost default.
# Alternatives: openai/gpt-oss-120b (higher quality, slower), llama-3.1-8b-instant (fastest/cheapest).
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=700

# Server-side key ONLY — must NOT have HTTP referrer restrictions (Google
# rejects referrer-restricted keys for Geocoding API and Places API
# server-to-server calls). Restrict this key by IP address (or leave
# unrestricted for local dev) and scope its API restrictions to
# Geocoding API + Places API (New) only. Shared on the team credentials
# sheet — ask before generating a new one.
GOOGLE_MAPS_SERVER_KEY=

# Google OAuth 2.0 Client ID — used to verify the ID token Google Identity
# Services hands back after "Sign in with Google". Unlike the Maps keys
# above, this is NOT a secret (it's embedded in the frontend bundle too, as
# VITE_GOOGLE_OAUTH_CLIENT_ID) — same value on both sides. Create it as a
# "Web application" OAuth client in Google Cloud Console, and add every
# origin you'll load the app from (http://localhost:5173, the real prod
# domain) under "Authorized JavaScript origins", or sign-in fails silently.
GOOGLE_OAUTH_CLIENT_ID=

# Microsoft OAuth 2.0 Client ID — used to verify the ID token MSAL hands back
# after "Sign in with Microsoft". Same "not a secret, same value on both
# sides" story as GOOGLE_OAUTH_CLIENT_ID above — this one is shared with
# VITE_MICROSOFT_OAUTH_CLIENT_ID. Create it as a "Single-page application"
# app registration in Microsoft Entra admin center (entra.microsoft.com),
# supporting "personal Microsoft accounts + any organizational directory",
# and add every origin you'll load the app from (http://localhost:5173, the
# real prod domain) under Authentication > Redirect URIs, or sign-in fails.
MICROSOFT_OAUTH_CLIENT_ID=
