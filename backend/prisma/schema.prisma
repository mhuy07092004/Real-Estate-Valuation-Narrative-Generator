// Local dev database. Swapping to production Postgres later is a
// datasource change only — provider + url — nothing in src/ changes.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Auth-only schema. Other tables (clients, reports, comparables, market
// data, etc.) were removed to be rebuilt from scratch on top of auth.

model Role {
  roleId   Int    @id @default(autoincrement()) @map("role_id")
  roleName String @unique @map("role_name")

  users User[]

  @@map("roles")
}

model User {
  userId       String    @id @default(uuid()) @map("user_id")
  fullName     String    @map("full_name")
  email        String    @unique
  passwordHash String?   @map("password_hash") // null for OAuth-only accounts
  authProvider String    @default("local") @map("auth_provider")
  roleId       Int       @map("role_id")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")

  role Role @relation(fields: [roleId], references: [roleId])
  clients Client[]

  @@map("users")
}

model Client {
  clientId    String   @id @default(uuid()) @map("client_id")
  ownerUserId String   @map("owner_user_id")
  fullName    String   @map("full_name")
  email       String
  phone       String
  status      String   @default("prospecting")
  notes       String?
  addressLine String   @map("address_line")
  suburb      String
  state       String
  postcode    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  owner User @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)

  @@unique([ownerUserId, email])
  @@map("clients")
}

model ComparableSale {
  comparableId String   @id @default(uuid()) @map("comparable_id")
  addressLine  String   @map("address_line")
  suburb       String
  state        String
  postcode     String
  propertyType String   @map("property_type")
  bedrooms     Int
  bathrooms    Int
  parking      Int
  areaSqm      Float    @map("area_sqm")
  soldPrice    Float    @map("sold_price")
  soldDate     DateTime @map("sold_date")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("comparable_sales")
}

model MarketIntelligence {
  marketId              String   @id @default(uuid()) @map("market_id")
  suburb                String
  state                 String
  medianPrice           Float    @map("median_price")
  medianPriceGrowthPct  Float    @map("median_price_growth_pct")
  monthlyGrowthPct      Float    @map("monthly_growth_pct")
  monthlyGrowthTrendPp  Float    @map("monthly_growth_trend_pp")
  daysOnMarket          Int      @map("days_on_market")
  daysOnMarketTrendDays Int      @map("days_on_market_trend_days")
  rentalYieldPct        Float    @map("rental_yield_pct")
  rentalYieldTrendPct   Float    @map("rental_yield_trend_pct")
  priceTrendJson        String   @map("price_trend_json")
  asOfMonth             DateTime @map("as_of_month")
  createdAt             DateTime @default(now()) @map("created_at")

  @@unique([suburb, state])
  @@map("market_intelligence")
}